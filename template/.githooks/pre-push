#!/usr/bin/env bash
set -euo pipefail

# Verify the commit being pushed, not potentially dirty working-tree files.
repo=$(git rev-parse --show-toplevel)
cd "$repo"
checked=' '
scratch=''
trap 'if [[ -n "$scratch" ]]; then rm -rf -- "$scratch"; fi' EXIT

while read -r local_ref local_oid remote_ref remote_oid; do
    [[ "$local_oid" =~ ^0+$ ]] && continue # Ref deletion.
    git cat-file -e "$local_oid" # An unavailable object is an error, not a pass.
    # Annotated tags are peeled; tags pointing to blobs/trees have no build.
    if ! tip=$(git rev-parse --verify "$local_oid^{commit}" 2>/dev/null); then
        continue
    fi
    [[ "$checked" == *" $tip "* ]] && continue
    if ! git cat-file -e "$tip:pom.xml" 2>/dev/null; then
        continue # Historical commits before Maven, or removal of the project.
    fi
    checked+="$tip "
    scratch=$(mktemp -d "${TMPDIR:-/tmp}/pre-push.XXXXXXXX")
    git archive "$tip" | tar -x -C "$scratch"
    echo "pre-push: verifying Maven gates for $local_ref ($tip); unit-test execution skipped" >&2
    if ! (
        cd "$scratch"
        # JAVA_HOME/PATH are inherited; Maven enforces JDK 25.
        # verify includes Spotless, Checkstyle and SpotBugs in configured snapshots.
        ./mvnw -B -ntp -DskipTests verify </dev/null
    ); then
        echo "pre-push: verification failed; push blocked." >&2
        exit 1
    fi
    rm -rf -- "$scratch"
    scratch=''
done
